<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.AutoPlaylist</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.AutoPlaylist</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- Analyzer strictness is deliberately left off: this builds on CI without a
         local .NET SDK, so warnings must not fail the release build. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CA1819;CA1002;CA2227;SA0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time only: the server provides these assemblies at runtime. -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Needed for the admin API controller and IHttpClientFactory. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
